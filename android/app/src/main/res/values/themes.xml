<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 dark base; Compose owns the actual color scheme via
         ui/theme/Theme.kt at runtime. This stub is only used while the
         system inflates the activity window before Compose kicks in. -->
    <style name="Theme.Alfred" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alfred_background</item>
        <item name="android:statusBarColor">@color/alfred_background</item>
        <item name="android:navigationBarColor">@color/alfred_background</item>
    </style>
</resources>

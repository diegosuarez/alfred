[Unit]
Description=Alfred — personal productivity Kanban and Pomodoro stack
Documentation=file://__ALFRED_DIR__/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__ALFRED_DIR__
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

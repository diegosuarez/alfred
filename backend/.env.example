# Copy to .env (gitignored) and fill in for local dev.
# docker-compose can pick up these vars automatically when placed at the
# repo root; for uv-managed local runs, `uv run --env-file .env ...`.

# Database --------------------------------------------------------------
# Relative path is resolved from the CWD where uvicorn is launched.
DATABASE_URL=sqlite+aiosqlite:///./data/alfred.db

# Auth (JWT) ------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public URLs -----------------------------------------------------------
# APP_URL is where the backend is reachable from a browser (used to build
# the Google OAuth redirect_uri). FRONTEND_URL is the SPA origin we
# redirect the user back to after a successful login.
APP_URL=http://localhost:30000
FRONTEND_URL=http://localhost:30001

# CORS (comma-separated list of allowed origins) -----------------------
CORS_ORIGINS=http://localhost:30001,http://127.0.0.1:30001

# Optional regex matched against the Origin header. Handy when reaching
# the stack over Tailscale / LAN where the hostname is dynamic.
# Example below allows any hostname on port 30001:
#   CORS_ORIGIN_REGEX=^https?://([^/]+):30001$
# CORS_ORIGIN_REGEX=

# Google OAuth2 ---------------------------------------------------------
# Create a Web Application credential at
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: $APP_URL/api/auth/google/callback
# Authorized JavaScript origin: $FRONTEND_URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
